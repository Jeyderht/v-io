# Copia este archivo como .env.local y completa los valores.
# Todas son públicas (NEXT_PUBLIC_*): se incrustan en el JavaScript del sitio.
# Nunca pongas aquí la clave "secret" ni la "service_role" de Supabase.

# Supabase → Project Settings → API → "Project URL"
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Supabase → Project Settings → API Keys → "Publishable key" (sb_publishable_…)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Tu WhatsApp con código de país, solo números (Perú = 51)
NEXT_PUBLIC_WHATSAPP=51999999999
# Color de acento
NEXT_PUBLIC_ACCENT=#1CA9E5
# URL pública del sitio, sin barra final (sitemap, robots y Open Graph)
NEXT_PUBLIC_SITE_URL=https://v-io.netlify.app
